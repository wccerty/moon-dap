{
  "name": "moon-dap-minilang",
  "displayName": "moon-dap 本地调试示例",
  "description": "为本地 TCP 调试示例注册调试类型和源码扩展名",
  "version": "0.1.0",
  "publisher": "wccerty",
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "languages": [
      { "id": "moon-dap-minilang", "aliases": ["moon-dap 示例"], "extensions": [".mdap"] }
    ],
    "breakpoints": [
      { "language": "moon-dap-minilang" }
    ],
    "debuggers": [
      {
        "type": "moon-dap-minilang",
        "label": "moon-dap 迷你解释器",
        "languages": ["moon-dap-minilang"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "待调试的 .mdap 源码绝对路径" },
              "stopOnEntry": { "type": "boolean", "description": "在第一条语句执行前暂停", "default": false }
            }
          }
        }
      }
    ]
  }
}
